# 환경변수 — API 키가 들어가므로 절대 커밋 금지
.env
.env.local
.env.*.local
!.env.example

# 의존성 / 빌드
node_modules/
.next/
out/
dist/
build/

# 로그 / 캐시
*.log
npm-debug.log*
.turbo/
.cache/

# OS / 에디터
.DS_Store
Thumbs.db
.idea/
.vscode/

# 변환 원본(대용량) — scripts/convert-shp.mjs 로 재생성 가능
data/raw/
*.shp
*.dbf
*.shx

.vercel
.env*
# 템플릿은 계속 추적한다 (위 .env* 보다 뒤에 와야 예외가 적용된다)
!.env.example

# 법정동 건축물대장 캐시 (수십 MB, 재생성 가능)
data/building-dong-cache.json

# 건축물대장 색인 (110MB, CSV 로 재생성 가능)
data/building-index.json

# 건축물대장 원본 CSV (1GB+)
.claude/*.csv

data/semi-basement-pks.json

data/expos-cache.json
data/land-right-cache.json
