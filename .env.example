# ─────────────────────────────────────────────────────────────
# 카카오 API 키 (실제 값은 .env.local 에만 두고 절대 커밋하지 말 것)
# ─────────────────────────────────────────────────────────────

# [공개 전제] 웹 프론트 지도 SDK용 JavaScript 키
# ⚠️ 반드시 카카오 개발자 콘솔 > 내 애플리케이션 > 플랫폼 > Web 에
#    서비스 도메인을 등록할 것 (미등록 시 제3자가 쿼터 무단 소진)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# [서버 전용] REST API 키 — 로컬 API(주소검색/좌표변환), 카카오 로그인 토큰 교환, 알림톡
# 🔴 절대 프론트엔드 코드나 NEXT_PUBLIC_ 접두사에 넣지 말 것
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# [앱 전용] Android/iOS 네이티브 SDK — 앱 빌드 설정에만 주입
KAKAO_NATIVE_APP_KEY=

# ─────────────────────────────────────────────────────────────
# 공공데이터 (PART 4 데이터 소스)
# ─────────────────────────────────────────────────────────────
DATA_GO_KR_SERVICE_KEY=      # 공공데이터포털 (실거래·건축물대장)
VWORLD_API_KEY=              # V-World (연속지적도 WMS, 지적 타일 임시 대체용)

# ─────────────────────────────────────────────────────────────
# 인프라
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/jisegaebal
REDIS_URL=redis://localhost:6379
